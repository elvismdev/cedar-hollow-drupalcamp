<?xml version="1.0"?>
<ruleset name="cedar_hollow">
  <description>Coding standards for the Cedar Hollow DrupalCamp project.</description>

  <arg name="extensions" value="php,module,inc,install,theme"/>
  <arg name="colors"/>

  <rule ref="Drupal"/>
  <rule ref="DrupalPractice"/>

  <file>web/modules/custom</file>
  <file>web/themes/custom/cedar_hollow/src</file>
  <file>scripts/sync-agenda-builder.php</file>
  <file>scripts/seed-demo-content.php</file>
  <file>scripts/fetch-demo-images.php</file>
  <file>scripts/place-demo-images.php</file>
  <file>scripts/check-demo-images.php</file>
</ruleset>
