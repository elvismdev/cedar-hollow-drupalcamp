{# Markup from uclahs/surface source/patterns/elements/breadcrumb (GPL-2.0-or-later). #}
{% set attributes = attributes ?: create_attribute() %}
{% set classes = tone == 'inverse' ? ['breadcrumb', 'breadcrumb--inverse'] : ['breadcrumb'] %}
<nav{{ attributes.addClass(classes) }} aria-label="{{ 'Breadcrumb'|t }}">
  <ol class="breadcrumb__list">
    {% for item in breadcrumb %}
      <li class="breadcrumb__item">
        {% if item.url %}
          <a href="{{ item.url }}" class="breadcrumb__link">
            {% if loop.first %}
              <svg class="breadcrumb__icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M12 3l9 8h-3v9h-5v-6h-2v6H6v-9H3z"/></svg>
              <span class="visually-hidden">{{ item.text }}</span>
            {% else %}
              {{ item.text }}
            {% endif %}
          </a>
          {% if not loop.last %}
            <svg class="breadcrumb__separator" aria-hidden="true" focusable="false" viewBox="0 0 192 512"><path fill="currentColor" d="M0 384.662V127.338c0-17.818 21.543-26.741 34.142-14.142l128.662 128.662c7.81 7.81 7.81 20.474 0 28.284L34.142 398.804C21.543 411.404 0 402.48 0 384.662z"></path></svg>
          {% endif %}
        {% else %}
          <span aria-current="page">{{ item.text }}</span>
        {% endif %}
      </li>
    {% endfor %}
  </ol>
</nav>
