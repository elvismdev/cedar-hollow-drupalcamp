{# Markup from uclahs/surface source/patterns/elements/title (GPL-2.0-or-later). #}
{% set attributes = attributes ?: create_attribute() %}
{% set level = level ?: '2' %}
{# Size defaults to the heading level; an explicit size replaces it. #}
<h{{ level }}{{ attributes.addClass('title', size ? 'title--size-' ~ size : 'title--h' ~ level) }}>
  {% set href = url|safe_href %}
  {% if href %}
    <a href="{{ href }}" class="title__link">{{ text }}</a>
  {% else %}
    {{ text }}
  {% endif %}
</h{{ level }}>
