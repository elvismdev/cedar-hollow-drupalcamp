{# Markup from uclahs/surface source/patterns/elements/button (GPL-2.0-or-later). #}
{% set attributes = attributes ?: create_attribute() %}
{% set classes = ['button'] %}
{% if variant and variant != 'default' %}
  {% set classes = classes|merge(['button--' ~ variant]) %}
{% endif %}
{% set href = url|safe_href %}
{% if href %}
  <a{{ attributes.addClass(classes).setAttribute('href', href) }}>{{ text }}</a>
{% else %}
  <button{{ attributes.addClass(classes).setAttribute('type', 'button') }}>{{ text }}</button>
{% endif %}
