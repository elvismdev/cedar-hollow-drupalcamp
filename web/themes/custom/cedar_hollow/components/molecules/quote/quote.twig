{# Markup based on uclahs/surface source/patterns/components/quote (GPL-2.0-or-later). #}
{% set attributes = attributes ?: create_attribute() %}
{% set classes = ['quote'] %}
{% if image.src %}
  {% set classes = classes|merge(['quote--with-image']) %}
{% endif %}
<div{{ attributes.addClass(classes) }}>
  <div class="quote__content">
    <div class="quote__text">
      <figure class="quote__figure">
        <blockquote class="quote__body">
          {{ quote }}
        </blockquote>
        <figcaption class="quote__author">{{ author }}</figcaption>
      </figure>
    </div>
    {% if image.src %}
      {% set srcset = image.src|toSrcSet(image.width) %}
      <div class="quote__image">
        <img
          class="quote__img"
          src="{{ image.src }}"
          {% if srcset %}srcset="{{ srcset }}" sizes="auto, 100vw"{% endif %}
          alt="{{ image.alt }}"
          {% if image.width %}width="{{ image.width }}"{% endif %}
          {% if image.height %}height="{{ image.height }}"{% endif %}
          loading="lazy"
        />
      </div>
    {% endif %}
  </div>
</div>
