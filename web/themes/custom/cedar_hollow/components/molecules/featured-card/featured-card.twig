{# Markup based on uclahs/surface source/patterns/components/featured-card (GPL-2.0-or-later). #}
{% set attributes = attributes ?: create_attribute() %}
<div{{ attributes.addClass('featured-card') }}>
  <div class="featured-card__layout">
    {% if image|render|trim %}
      <div class="featured-card__image">
        {{ image }}
      </div>
    {% endif %}
    <div class="featured-card__content">
      {% if eyebrow %}
        {% include 'cedar_hollow:eyebrow' with {text: eyebrow} only %}
      {% endif %}
      {% include 'cedar_hollow:title' with {text: heading, url: url, level: '3', size: 'large'} only %}
      {% if subtitle %}
        <p class="featured-card__subtitle">{{ subtitle }}</p>
      {% endif %}
      {% if organization|render|trim %}
        <div class="featured-card__organization"><svg class="featured-card__organization-icon" aria-hidden="true" focusable="false" viewBox="0 0 24 24" width="16" height="16"><path fill="currentColor" d="M12 2a7 7 0 0 1 7 7c0 5-7 13-7 13S5 14 5 9a7 7 0 0 1 7-7zm0 4.5a2.5 2.5 0 1 0 0 5 2.5 2.5 0 0 0 0-5z"/></svg>{{ organization }}</div>
      {% endif %}
      {% if date_text %}
        <div class="featured-card__dates">
          {% include 'cedar_hollow:date' with {text: date_text} only %}
          {% if more_dates_url %}
            {% include 'cedar_hollow:button' with {text: '+ more dates'|t, url: more_dates_url, variant: 'link'} only %}
          {% endif %}
        </div>
      {% endif %}
      {% if readtime %}
        {% include 'cedar_hollow:readtime' with {text: readtime} only %}
      {% endif %}
      {% if cta_text and cta_url %}
        {% include 'cedar_hollow:button' with {text: cta_text, url: cta_url, variant: cta_variant ?: 'secondary', attributes: create_attribute({class: ['featured-card__action']})} only %}
      {% endif %}
    </div>
  </div>
</div>
