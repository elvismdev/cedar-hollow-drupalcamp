{#
/**
 * @file
 * Session page. Passes data to components; values come from preprocess in
 * ThemeHooks::preprocessNodeSession().
 */
#}
{{ attach_library('cedar_hollow/sessions') }}
{% set body %}
  {% if content.field_image|render|trim %}
    <div class="session__image">{{ content.field_image }}</div>
  {% endif %}
  <div class="session__summary">
    {% if date_badge %}
      {% include 'cedar_hollow:date-badge' with date_badge only %}
    {% endif %}
    {% include 'cedar_hollow:session-meta' with {time_range: time_range, room: room, track: track_label} only %}
    {% if seats %}
      {% include 'cedar_hollow:seats-indicator' with seats|merge({attributes: create_attribute({class: ['session__seats']})}) only %}
    {% endif %}
  </div>
  {{ content.field_speakers }}
  {% if content.body|render|trim %}
    <div class="prose">{{ content.body }}</div>
  {% endif %}
  {{ content.field_registration }}
  {{ content.field_forward }}
  {{ content|without('body', 'field_registration', 'field_forward', 'field_session_time', 'field_room', 'field_track', 'field_speakers', 'field_day', 'field_image') }}
{% endset %}
<article{{ attributes.addClass('session') }}>
  {% include 'cedar_hollow:page-section' with {width: 'narrow', content: body} only %}
</article>
