{
  "name": "cedar-hollow-tests",
  "private": true,
  "description": "End-to-end, accessibility and smoke tests for the Cedar Hollow DrupalCamp demo.",
  "scripts": {
    "test": "playwright test --project=e2e --project=a11y",
    "test:smoke": "playwright test --project=smoke --project=a11y",
    "pa11y": "pa11y-ci --config a11y/pa11yci.cjs"
  },
  "devDependencies": {
    "@axe-core/playwright": "4.14.0",
    "@playwright/test": "1.64.1",
    "pa11y-ci": "5.0.0"
  }
}
