{
  "source": "Claude Code 2.1.316 (versions/2.1.316, the binary's v2o function run under Node 22 with Node's path module): each row is an absolute Glob pattern, the folder Claude Code searches and the glob it passes to ripgrep.",
  "splits": [
    [
      "/a/b/*.json",
      "/a/b",
      "*.json"
    ],
    [
      "/a/b/c.txt",
      "/a/b",
      "c.txt"
    ],
    [
      "/*.json",
      "/",
      "*.json"
    ],
    [
      "/a/{b,c}/d/*.php",
      "/a",
      "{b,c}/d/*.php"
    ],
    [
      "/a/b/{c,d}.php",
      "/a/b",
      "{c,d}.php"
    ],
    [
      "/a/{b,{c,d}}/*",
      "/a",
      "{b,{c,d}}/*"
    ],
    [
      "/a/{b,c}/{d,e}/*.php",
      "/a",
      "{b,c}/{d,e}/*.php"
    ],
    [
      "/a/b*/c",
      "/a",
      "b*/c"
    ],
    [
      "/{a,b}/c",
      "/",
      "{a,b}/c"
    ],
    [
      "/a/**/x.php",
      "/a",
      "**/x.php"
    ],
    [
      "/a/b/",
      "/a",
      "b"
    ],
    [
      "/a",
      "/",
      "a"
    ],
    [
      "/mnt/audit/poc-write/in/*.json",
      "/mnt/audit/poc-write/in",
      "*.json"
    ],
    [
      "/a/b/c{d,e}/f",
      "/a/b",
      "c{d,e}/f"
    ],
    [
      "/a/b/x?y/z",
      "/a/b",
      "x?y/z"
    ],
    [
      "/a/[bc]/d",
      "/a",
      "[bc]/d"
    ],
    [
      "/a/b/c/",
      "/a/b",
      "c"
    ]
  ]
}
