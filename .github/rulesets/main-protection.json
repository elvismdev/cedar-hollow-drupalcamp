{
  "name": "main-protection",
  "target": "branch",
  "enforcement": "active",
  "conditions": {
    "ref_name": {
      "include": [
        "~DEFAULT_BRANCH"
      ],
      "exclude": []
    }
  },
  "bypass_actors": [
    {
      "actor_id": 5,
      "actor_type": "RepositoryRole",
      "bypass_mode": "pull_request"
    }
  ],
  "rules": [
    {
      "type": "pull_request",
      "parameters": {
        "required_approving_review_count": 0,
        "dismiss_stale_reviews_on_push": false,
        "require_code_owner_review": false,
        "require_last_push_approval": false,
        "required_review_thread_resolution": false,
        "allowed_merge_methods": [
          "merge"
        ]
      }
    },
    {
      "type": "non_fast_forward"
    },
    {
      "type": "deletion"
    },
    {
      "type": "required_status_checks",
      "parameters": {
        "strict_required_status_checks_policy": true,
        "do_not_enforce_on_create": false,
        "required_status_checks": [
          {
            "context": "PHP standards, static analysis and security audit",
            "integration_id": 15368
          },
          {
            "context": "Theme CSS, component hierarchy, Storybook build and tests, and npm audit",
            "integration_id": 15368
          },
          {
            "context": "PHPUnit (kernel and functional)",
            "integration_id": 15368
          },
          {
            "context": "Playwright end-to-end, accessibility and smoke on a site rebuilt from code",
            "integration_id": 15368
          },
          {
            "context": "Visual regression on Storybook templates",
            "integration_id": 15368
          },
          {
            "context": "Reviewer tools tests",
            "integration_id": 15368
          }
        ]
      }
    }
  ]
}
